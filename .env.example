# Copiar a .env y completar. El archivo .env nunca se sube a git.
ENV=dev

# OCI
OCI_REGION=sa-saopaulo-1
OCI_NAMESPACE=
OCI_BUCKET_DEV=mediflow-dev
OCI_BUCKET_PROD=mediflow-prod
OCI_COMPARTMENT=
OCI_AUTH=config
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT

# Alertas (N2-09): prioridad N8N > DISCORD > OCI
N8N_WEBHOOK_URL=http://n8n:5678/webhook/mediflow-alert   # n8n (N3-08); si falla, cae a Discord y luego OCI
SLACK_WEBHOOK_URL=              # Slack Incoming Webhook; solo lo recibe el contenedor n8n
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires   # zona horaria de n8n
ALERTA_OCULTAR_PACIENTE=        # true: la alerta no incluye el nombre del paciente
DISCORD_WEBHOOK_URL=            # URL del webhook de Discord/Slack
ONS_TOPIC_OCID=ocid1.onstopic.oc1..REEMPLAZAR



# Autonomous AI Database
ADB_DSN=mediflow_dev_high
ADB_USER=mediflow_app
ADB_PASSWORD=                   # solo en local; en prod se lee de Vault
ADB_WALLET_DIR=./wallet

# Modelos. Ajustar a la versión vigente de cada proveedor el día del kickoff.
# OpenRouter free models (recommended):
#   - meta-llama/llama-3.2-3b-instruct:free (triage/clasificar)
#   - mistralai/mistral-7b-instruct:free (extraction/extraer)
#   - google/gemma-2-9b-it:free (alternative)
# Format: openrouter/<model-id>
LLM_PRIMARY=openrouter/meta-llama/llama-3.2-3b-instruct:free
LLM_FALLBACKS=openrouter/mistralai/mistral-7b-instruct:free,openrouter/google/gemma-2-9b-it:free
LLM_REINTENTOS=3
LLM_BACKOFF_BASE=2

# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenRouter optional headers for ranking/attribution
OPENROUTER_REFERER=https://github.com/MediFlow
OPENROUTER_TITLE=MediFlow App

# Phoenix / OpenInference observabilidad
PHOENIX_ENABLED=true          # true en dev, false en prod (o forzar con true/false)
PHOENIX_HOST=0.0.0.0
PHOENIX_PORT=6006
PHOENIX_WORKING_DIR=./phoenix_data

# Legacy keys (kept for backward compatibility, not used with OpenRouter)
GEMINI_API_KEY=                 # solo en local; en prod se lee de Vault
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_SECRET_OCID=             # OCID del secreto en OCI Vault (prod)

# Umbrales por defecto (en el sprint 3 se leen desde la tabla rules)
CONFIDENCE_AUTO=0.85
CONFIDENCE_SECOND_OPINION=0.60
LEGIBILITY_MIN=0.40
# Edición de reglas (PUT /rules). Sin RULES_ADMIN_TOKEN el endpoint queda desactivado (503).
# Defínela en tu entorno o en la VM; nunca subas un valor real al repo.
RULES_ADMIN_TOKEN=
# Opcionales (por defecto van en ./data/): archivo con las reglas editadas y registro de cambios
# RULES_OVERRIDE_PATH=
# RULES_AUDIT_PATH=

# UI
API_URL=http://localhost:8000

STORAGE_BACKEND=local
# Carpeta base del almacenamiento local (para tests)
# Si no se define, usa ./data/ del proyecto
MEDIFLOW_DATA_DIR=

# Clave externa opcional; vacia omite la referencia de paciente.
MEDIFLOW_CLAVE_SEUDONIMO=
