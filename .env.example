# Copiar a .env y completar. El archivo .env nunca se sube a git.
ENV=dev

# OCI
OCI_REGION=sa-saopaulo-1
OCI_NAMESPACE=
OCI_BUCKET=mediflow-dev
OCI_AUTH=config                 # config en local (~/.oci/config), instance_principal en la VM
OCI_CONFIG_PROFILE=DEFAULT
ONS_TOPIC_OCID=

# Autonomous AI Database
ADB_DSN=mediflow_dev_high
ADB_USER=mediflow_app
ADB_PASSWORD=                   # solo en local; en prod se lee de Vault
ADB_WALLET_DIR=./wallet

# Modelos. Ajustar a la versión vigente de cada proveedor el día del kickoff.
# Opciones Cloud (por defecto):
LLM_PRIMARY=gemini/gemini-2.5-flash
LLM_FALLBACKS=groq/meta-llama/llama-4-scout-17b-16e-instruct,mistral/mistral-small-latest
# Segunda opinión (opcional, si está vacío elige el primer respaldo disponible distinto al principal):
LLM_SEGUNDA_OPINION=

# Opciones Locales / Edge (ver docs/architecture.md sección 7):
# LLM_PRIMARY=openai/google/gemma-3-4b-it
# LLM_FALLBACKS=openai/Qwen/Qwen2.5-VL-3B-Instruct,openai/openbmb/MiniCPM-V-4
# LLM_SEGUNDA_OPINION=openai/Qwen/Qwen2.5-VL-3B-Instruct
# OPENAI_API_BASE=http://localhost:8000/v1

GEMINI_API_KEY=                 # solo en local; en prod se lee de Vault
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_SECRET_OCID=             # OCID del secreto en OCI Vault (prod)
USE_LLM=false                   # true para activar inferencia real con LLM; false para modo determinístico por reglas

# Ingestión y límites
MEDIFLOW_MAX_UPLOAD_BYTES=20971520   # 20 MB
MEDIFLOW_MAX_PDF_PAGES=50
MEDIFLOW_MAX_PAGINAS_MODELO=4
MEDIFLOW_OCR_LANG=spa+por+eng

# Almacenamiento
STORAGE_BACKEND=local           # 'local' guarda en ./data/{bucket}/; 'oci' usa OCI Object Storage
# MEDIFLOW_DATA_DIR=./data      # ruta local alternativa si se ejecuta fuera de la raíz

# Umbrales por defecto (en el sprint 3 se leen desde la tabla rules)
CONFIDENCE_AUTO=0.85
CONFIDENCE_SECOND_OPINION=0.60
LEGIBILITY_MIN=0.40

# UI
API_URL=http://localhost:8000
